# Supabase project credentials (safe for the client — protected by RLS).
# Find these in your Supabase project: Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never put the service_role key in an EXPO_PUBLIC_ variable or anywhere
# inside this app — it bypasses RLS entirely and must only ever live in a
# server-side environment (e.g. an Edge Function secret).
